# ConnectHub Environment Configuration Template

# --------------------------------------------------
# CORE APPLICATION SETTINGS
# --------------------------------------------------
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///application.db
COOKIE_SECURE=false
PORT=5000
FLASK_DEBUG=false
MAX_UPLOAD_SIZE=16777216

# --------------------------------------------------
# SYSTEM SMTP EMAIL CONFIGURATION (Optional fallback)
# --------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --------------------------------------------------
# FIREBASE AUTHENTICATION CONFIGURATION
# (Used for Forgot Password reset emails and Continue with Google)
# --------------------------------------------------
# 1. Web Client Config (from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
FIREBASE_API_KEY=AIzaSy...
FIREBASE_PROJECT_ID=connecthub-project-id
FIREBASE_AUTH_DOMAIN=connecthub-project-id.firebaseapp.com
FIREBASE_APP_ID=1:1234567890:web:abcdef123456
FIREBASE_STORAGE_BUCKET=connecthub-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# 2. Firebase Admin SDK Service Account (Optional for server-side token validation)
# Download JSON key from Firebase Console -> Project Settings -> Service accounts
FIREBASE_CREDENTIALS_PATH=instance/firebase_credentials.json

# --------------------------------------------------
# WEB PUSH & WINDOWS DESKTOP NOTIFICATIONS (VAPID)
# --------------------------------------------------
# Generate keys using: py -c "from pywebpush import WebPusher; import json; ..." or openssl
# ConnectHub will auto-generate an ephemeral keypair on launch if not supplied here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:admin@connecthub.com
